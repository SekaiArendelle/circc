// RUN: %circc translate --input=%s --output=%t.cpp
// RUN: FileCheck %s --match-full-lines --input-file=%t.cpp
// RUN: %clangxx -std=c++17 -fsyntax-only %t.cpp
// RUN: %circc translate --input=%s --language=c++20 --output=%t.cpp
// RUN: %clangxx -std=c++20 -fsyntax-only %t.cpp
// RUN: %circc translate --input=%s --language=c++23 --output=%t.cpp
// RUN: %clangxx -std=c++23 -fsyntax-only %t.cpp
// RUN: %circc translate --input=%s --language=c++26 --output=%t.cpp
// RUN: %clangxx -std=c++26 -fsyntax-only %t.cpp

// CHECK: #include <stdint.h>

!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>

module {
  cir.func @answer() -> !s32i {
    %slot = cir.alloca "answer" align(4) : !cir.ptr<!s32i>
    %constant = cir.const #cir.int<42> : !s32i
    cir.store %constant, %slot : !s32i, !cir.ptr<!s32i>
    %value = cir.load %slot : !cir.ptr<!s32i>, !s32i
    cir.return %value : !s32i
  }
// CHECK-NEXT: int32_t answer() {
// CHECK-NEXT:   int32_t v1;
// CHECK-NEXT:   int32_t* v2 = &v1;
// CHECK-NEXT:   int32_t v3 = 42;
// CHECK-NEXT:   v1 = v3;
// CHECK-NEXT:   int32_t v4 = v1;
// CHECK-NEXT:   return v4;
// CHECK-NEXT: }

  cir.func @identity(%argument: !u64i) -> !u64i {
    cir.return %argument : !u64i
  }
// CHECK-NEXT: uint64_t identity(uint64_t v1) {
// CHECK-NEXT:   return v1;
// CHECK-NEXT: }
// CHECK-NOT: {{.}}
}
