!s32i = !cir.int<s, 32>
!u64i = !cir.int<u, 64>

module {
  cir.func @answer() -> !s32i {
    %slot = cir.alloca "answer" align(4) : !cir.ptr<!s32i>
    %constant = cir.const #cir.int<42> : !s32i
    cir.store %constant, %slot : !s32i, !cir.ptr<!s32i>
    %value = cir.load %slot : !cir.ptr<!s32i>, !s32i
    cir.return %value : !s32i
  }

  cir.func @identity(%argument: !u64i) -> !u64i {
    cir.return %argument : !u64i
  }
}
