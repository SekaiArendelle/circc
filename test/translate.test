# RUN: %circc translate --input=%S/Inputs/basic.cir --output=%t.cpp
# RUN: FileCheck %s --input-file=%t.cpp
# RUN: %clangxx -std=c++17 -fsyntax-only %t.cpp

# CHECK: #include <stdint.h>
# CHECK-NEXT: int32_t answer() {
# CHECK-NEXT:   int32_t v1;
# CHECK-NEXT:   int32_t* v2 = &v1;
# CHECK-NEXT:   int32_t v3 = 42;
# CHECK-NEXT:   v1 = v3;
# CHECK-NEXT:   int32_t v4 = v1;
# CHECK-NEXT:   return v4;
# CHECK-NEXT: }
# CHECK-NEXT: uint64_t identity(uint64_t v1) {
# CHECK-NEXT:   return v1;
# CHECK-NEXT: }
