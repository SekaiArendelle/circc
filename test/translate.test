# RUN: %circc translate --input=%S/Inputs/basic.cir | FileCheck %s

# CHECK: #include <stdint.h>
# CHECK: int32_t answer(void) {
# CHECK-NEXT:   _Alignas(4) int32_t answer;
# CHECK-NEXT:   answer = ((int32_t)(INT64_C(42)));
# CHECK-NEXT:   int32_t v0 = answer;
# CHECK-NEXT:   return v0;
# CHECK-NEXT: }
# CHECK: uint64_t identity(uint64_t arg0) {
# CHECK-NEXT:   return arg0;
# CHECK-NEXT: }
# CHECK: void notify(void);
